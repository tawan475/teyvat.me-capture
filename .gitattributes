* text eol=lf
*.png binary
*.jpg binary
*.webp binary
*.gz binary
*.ico binary
*.icns binary
# Fonts, archives and native files: never line-ending converted. A .ttf
# stored as text lost its CR bytes and drew text with missing letters.
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary
*.jar binary
*.zip binary
*.apk binary
*.so binary
*.pcapng binary
*.jks binary
docs/src/images/*.webp filter=lfs diff=lfs merge=lfs -text
