<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- The underlying network's DNS servers (GameVpnService). -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- GameVpnService runs in the foreground; systemExempted is the type
         Android 14+ allows for a consented VPN app. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SYSTEM_EXEMPTED" />
    <!-- Its notification (with Stop), asked for at Start on Android 13+. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- The VPN's allowed list names the game, which needs it visible (API 30+). -->
    <queries>
        <package android:name="com.miHoYo.GenshinImpact" />
    </queries>

    <application
        android:label="Teyvat.me (spike)"
        android:allowBackup="false">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".GameVpnService"
            android:exported="false"
            android:foregroundServiceType="systemExempted"
            android:permission="android.permission.BIND_VPN_SERVICE">
            <intent-filter>
                <action android:name="android.net.VpnService" />
            </intent-filter>
        </service>
    </application>
</manifest>
