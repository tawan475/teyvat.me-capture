<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- The underlying network's DNS servers (GameVpnService). -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- GameVpnService runs in the foreground; systemExempted is the type
         Android 14+ allows for a consented VPN app. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SYSTEM_EXEMPTED" />
    <!-- The capture notification, asked for in Set up and at Start (13+). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- The self-update (Updater.kt): installs a newer release of this app. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- Lets Android honour the update's USER_ACTION_NOT_REQUIRED (12+) once
         this app installed the version that runs; without it every update
         asked, even from the background. -->
    <uses-permission android:name="android.permission.UPDATE_PACKAGES_WITHOUT_USER_ACTION" />
    <!-- Battery.kt: asks to run unrestricted, so battery savers don't pause
         exports and uploads while the game is in front. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- The VPN's allowed list names the game, which needs it visible (API 30+);
         also Open Genshin. -->
    <queries>
        <package android:name="com.miHoYo.GenshinImpact" />
        <!-- Custom Tabs for the links. -->
        <intent>
            <action android:name="android.support.customtabs.action.CustomTabsService" />
        </intent>
    </queries>

    <application
        android:name=".TeyvatApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Teyvat">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/launcher_name"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".GameVpnService"
            android:exported="false"
            android:foregroundServiceType="systemExempted"
            android:permission="android.permission.BIND_VPN_SERVICE">
            <intent-filter>
                <action android:name="android.net.VpnService" />
            </intent-filter>
        </service>

        <!-- Quick Settings: start capture and open Genshin, or stop capture. -->
        <service
            android:name=".CaptureTile"
            android:exported="true"
            android:icon="@drawable/ic_capture"
            android:label="@string/launcher_name"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
            <meta-data
                android:name="android.service.quicksettings.TOGGLEABLE_TILE"
                android:value="true" />
        </service>

        <!-- The resin alert's alarm (ResinAlert.kt). -->
        <receiver
            android:name=".ResinAlarm"
            android:exported="false" />

        <!-- PackageInstaller's answer about a self-update. -->
        <receiver
            android:name=".InstallResult"
            android:exported="false" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
